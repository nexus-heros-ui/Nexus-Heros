<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Nexus Heroes | Live 3D Character Preview</title><script type="importmap">{"imports":{"three":"https://cdn.jsdelivr.net/npm/three@0.160.1/build/three.module.js"}}</script><style>body{margin:0;background:#080e1b;color:#f2f6ff;font:16px Arial,sans-serif}header{padding:20px 4vw;background:#121e36;border-bottom:1px solid #375783}h1{margin:0;color:#93c5fd}p{color:#c3d4ef}.layout{display:grid;grid-template-columns:minmax(0,1.5fr) minmax(270px,1fr);gap:18px;margin:20px auto;max-width:1250px;padding:0 18px}#viewport{height:min(73vh,700px);min-height:420px;border:2px solid #4769a4;border-radius:16px;background:radial-gradient(ellipse at 50% 30%,#2b416c,#0a1020 70%);touch-action:none;overflow:hidden}canvas{width:100%;height:100%;display:block}aside{background:#16243c;border-radius:16px;padding:20px}label{display:block;margin:20px 0 7px;font-weight:bold}select,input,button{font:inherit}select,input[type=color]{width:100%;height:44px;border-radius:8px;background:#0b1629;color:white;border:1px solid #6184b4}button,a.button{display:inline-block;background:#2865c9;color:white;padding:12px 16px;border:0;border-radius:9px;text-decoration:none;margin-top:14px;cursor:pointer}#status{color:#aee2ff;min-height:45px}.hint{font-size:14px}a{color:#b7d5ff}@media(max-width:800px){.layout{grid-template-columns:1fr}#viewport{height:52vh;min-height:360px}}</style></head><body><header><h1>⚡ Nexus Heroes — 3D Character Preview</h1><p>See the actual Quaternius male and female superhero models before using them in the full game.</p></header><main class="layout"><div><div id="viewport"></div><p class="hint">Drag to rotate • Scroll to zoom • Change hero model on the right.</p></div><aside><h2>Character Creator</h2><label for="gender">Hero model</label><select id="gender"><option value="Male">Male Superhero</option><option value="Female">Female Superhero</option></select><label for="build">Body build</label><select id="build"><option value="1">Athletic</option><option value="0.9">Slim</option><option value="1.12">Broad</option></select><label for="color">Suit tint</label><input type="color" id="color" value="#ffffff"><button id="reset">Reset appearance</button><p id="status">Loading 3D engine…</p><a class="button" href="index.html">Open Full Nexus Heroes Game →</a><p class="hint">This preview uses the real downloaded models. It does not yet include interchangeable costumes or hair.</p></aside></main><script type="module">
import * as THREE from 'three';
import {GLTFLoader} from 'https://cdn.jsdelivr.net/npm/three@0.160.1/examples/jsm/loaders/GLTFLoader.js';
const el=document.getElementById('viewport'),status=document.getElementById('status'),gender=document.getElementById('gender'),build=document.getElementById('build'),color=document.getElementById('color');
const scene=new THREE.Scene(),camera=new THREE.PerspectiveCamera(40,1,.1,100);let renderer,hero=null,angle=0,zoom=6,request=0,drag=false,last=0;
try{renderer=new THREE.WebGLRenderer({antialias:true,alpha:true});renderer.setPixelRatio(Math.min(devicePixelRatio,2));renderer.outputColorSpace=THREE.SRGBColorSpace;el.appendChild(renderer.domElement)}catch(e){status.textContent='WebGL unavailable: '+e.message;throw e}
scene.add(new THREE.HemisphereLight(0xffffff,0x304164,2.2));let light=new THREE.DirectionalLight(0xffffff,3);light.position.set(4,7,5);scene.add(light);light=new THREE.DirectionalLight(0x80baff,1.4);light.position.set(-4,5,-4);scene.add(light);const pedestal=new THREE.Mesh(new THREE.CylinderGeometry(1.4,1.5,.15,48),new THREE.MeshStandardMaterial({color:0x213454}));pedestal.position.y=-.09;scene.add(pedestal);
const loader=new GLTFLoader();function draw(){renderer.render(scene,camera)}function resize(){const b=el.getBoundingClientRect();camera.aspect=b.width/b.height;camera.updateProjectionMatrix();renderer.setSize(b.width,b.height,false);draw()}new ResizeObserver(resize).observe(el);
function update(){if(!hero)return;hero.scale.x=hero.userData.scale*Number(build.value);const tint=new THREE.Color(color.value);hero.traverse(o=>{if(o.isMesh){const materials=Array.isArray(o.material)?o.material:[o.material];materials.forEach(m=>{if(m.name?.includes('Superhero_')){m.color.copy(tint);m.needsUpdate=true}})}});draw()}
async function load(){const id=++request;status.textContent='Loading '+gender.value+' superhero…';try{const gltf=await loader.loadAsync('assets/heroes/Superhero_'+gender.value+'_FullBody.gltf');if(id!==request)return;if(hero)scene.remove(hero);hero=gltf.scene;const bounds=new THREE.Box3().setFromObject(hero),size=bounds.getSize(new THREE.Vector3()),center=bounds.getCenter(new THREE.Vector3()),scale=3/Math.max(size.y,.01);hero.position.sub(center);hero.position.y+=size.y/2;hero.scale.setScalar(scale);hero.userData.scale=scale;hero.rotation.y=angle;scene.add(hero);camera.position.set(0,1.55,zoom);camera.lookAt(0,1.5,0);update();status.textContent=gender.value+' superhero loaded successfully.'}catch(e){console.error(e);status.textContent='Model failed to load. Use a local web server or GitHub Pages and keep the assets folder next to this HTML. '+e.message}}
gender.addEventListener('change',load);build.addEventListener('change',update);color.addEventListener('input',update);document.getElementById('reset').onclick=()=>{build.value='1';color.value='#ffffff';angle=0;if(hero)hero.rotation.y=0;update()};el.addEventListener('pointerdown',e=>{drag=true;last=e.clientX;el.setPointerCapture(e.pointerId)});el.addEventListener('pointermove',e=>{if(!drag)return;angle+=(e.clientX-last)*.009;last=e.clientX;if(hero)hero.rotation.y=angle;draw()});el.addEventListener('pointerup',()=>drag=false);el.addEventListener('pointercancel',()=>drag=false);el.addEventListener('wheel',e=>{e.preventDefault();zoom=Math.max(3.5,Math.min(10,zoom+e.deltaY*.006));camera.position.z=zoom;draw()},{passive:false});resize();load();
</script></body></html>
